# Copy to .env and fill in. Real values never get committed (see .gitignore).

# --- LLM provider (ADR-0001) ---
LLM_PROVIDER=groq               # groq | openrouter | together | ollama
LLM_API_KEY=
LLM_MODEL=                      # e.g. a Qwen 3.x model id; final choice decided by evals
LLM_BASE_URL=                   # provider's OpenAI-compatible base URL
JUDGE_LLM_MODEL=                # stronger/different model than LLM_MODEL, used only for eval scoring

# --- Embeddings (ADR-0001) ---
EMBEDDINGS_MODEL=                # multilingual-e5 or bge-m3 class model, runs on CPU

# --- Data (ADR-0003, ADR-0004) ---
DATA_DIR=data/sample/members     # data/sample/members locally by default; ../bg-center-data/members for real data

# --- Postgres (ADR-0002) ---
DATABASE_URL=

# --- Langfuse (docs/design.md § Logging and observability) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # EU region

# --- Access (docs/design.md § Privacy and safety) ---
INVITE_CODE=
JWT_SECRET=

# --- CORS (docs/design.md § API contract) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend (consumed at build time) ---
VITE_API_BASE_URL=http://localhost:8000
